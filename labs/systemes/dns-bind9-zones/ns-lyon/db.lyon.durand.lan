$TTL 3600
@       IN SOA  ns-lyon.lyon.durand.lan. hostmaster.durand.lan. (
                2026101801 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                300 )      ; negative TTL
        IN NS   ns-lyon.lyon.durand.lan.
ns-lyon IN A    10.30.0.60
srv-lyon IN A   10.31.0.10
imprimante-lyon IN A 10.31.0.50
