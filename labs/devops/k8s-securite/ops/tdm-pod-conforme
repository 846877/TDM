#!/bin/sh
# tdm-pod-conforme NOM NAMESPACE [label=valeur] : manifeste d'un pod busybox conforme au profil
# « restricted » des Pod Security Standards (utilisé par les vérifications du lab).
nom=$1; ns=$2; label=${3:-tdm=sonde}
cat <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $nom
  namespace: $ns
  labels:
    ${label%%=*}: "${label#*=}"
spec:
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: sonde
      image: busybox:1.36
      command: ["sleep", "120"]
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
EOF
