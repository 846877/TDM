# Lab « Adressage IP et diagnostic » : SRV01 (Windows Server 2022, 2 Go : DNS + IIS) et PC01
# (Windows 11, 3 Go, carte LAN à configurer par l'élève). Prévoir 8 Go de RAM libres.
# L'ordre compte : SRV01 est défini en premier (adresse MAC LAN 08:00:27:AA:7C:01, vérifiée par un exercice).
require_relative "../_commun/tdm"

Vagrant.configure("2") do |config|
  TDM.lab(config, __dir__) do |lab|
    lab.server "srv01", hostname: "SRV01", ip: "192.168.10.10", scenario: "scenario-srv01.ps1"
    lab.client "pc01", hostname: "PC01", primary: true, scenario: "scenario.ps1"
  end
end
