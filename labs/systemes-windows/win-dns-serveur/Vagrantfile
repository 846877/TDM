# Lab « Serveur DNS » : SRV-DNS01, un Windows Server 2022 autonome (2 Go) avec le rôle DNS (zones fichier).
require_relative "../_commun/tdm"

Vagrant.configure("2") do |config|
  TDM.lab(config, __dir__) do |lab|
    lab.server "dns01", hostname: "SRV-DNS01", ip: "192.168.10.11", primary: true, scenario: "scenario.ps1"
  end
end
