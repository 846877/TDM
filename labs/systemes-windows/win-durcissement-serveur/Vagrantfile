# Lab « Durcissement d'un serveur » : SRV01, un Windows Server 2022 autonome (2 Go) livré avec une
# configuration de sécurité faible (scenario.ps1).
require_relative "../_commun/tdm"

Vagrant.configure("2") do |config|
  TDM.lab(config, __dir__) do |lab|
    lab.server "srv01", hostname: "SRV01", ip: "192.168.10.10", primary: true, scenario: "scenario.ps1"
  end
end
